# ==========================================
# TypeMentor Backend Production Environment Template
# ==========================================

# Database Configuration (PostgreSQL URI)
# In production on Render/Railway/Supabase, use your managed PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password123@localhost:5432/typementor_db"

# JWT Authentication (Use a strong 64-character random string in production)
JWT_SECRET="generate_a_secure_64_character_random_string_for_production"
JWT_EXPIRES_IN="7d"

# Server Port and Node Environment
PORT=5000
NODE_ENV=production

# CORS Configuration: Comma-separated list of allowed origins (e.g. your Vercel and custom domains)
ALLOWED_ORIGINS="https://typementor.in,https://www.typementor.in,https://typementor-ai-frontend.vercel.app"

# Reverse proxy hop count for client IP extraction & rate limiting
# Set to 1 behind single ingress proxy (Render, Railway, Heroku, Cloudflare, Nginx)
TRUST_PROXY_HOPS=1

# Admin Logins (Comma-separated emails authorized for Ops Dashboard)
ADMIN_EMAILS="admin@typementor.dev"

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_QUERY_TIMEOUT_MS=10000
DB_CONNECTION_TIMEOUT_MS=5000

# Rate Limiting (Default: 1500 requests / 15 minutes per IP)
RATE_LIMIT_GLOBAL_MAX=1500

# Authentication Providers
GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# AI Coaching Provider Configuration
# Supported providers: 'gemini' | 'openai' | 'local' | 'mock'
# Default: 'gemini' if GEMINI_API_KEY is present, otherwise 'local' rule engine
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2
GEMINI_API_KEY=""
OPENAI_API_KEY=""
