DATABASE_URL="postgresql://postgres:password123@localhost:5432/typementor_db"
JWT_SECRET="typementor_super_secret_jwt_key_2024"
JWT_EXPIRES_IN="7d"
PORT=5000
NODE_ENV=development # Set to production in permanent deployment

# CORS Configuration: comma-separated list of allowed origins. Required in production.
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:4173,http://localhost:3000"

# Reverse proxy hop count for client IP extraction & rate limiting (default: 1 for single ingress proxy)
TRUST_PROXY_HOPS=1

GOOGLE_CLIENT_ID="your_google_client_id_here"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# AI Coaching Provider Configuration
# Supported providers: 'gemini' | 'openai' | 'local' | 'mock'
# Default: 'gemini' if GEMINI_API_KEY is present, otherwise 'local'
AI_PROVIDER="gemini"
AI_MODEL="gemini-1.5-flash"
AI_TIMEOUT_MS=10000
AI_MAX_RETRIES=2
