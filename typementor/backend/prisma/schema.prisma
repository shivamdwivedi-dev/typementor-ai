datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String?
  googleId          String?           @unique
  name              String
  avatar            String?
  level             Int               @default(1)
  xp                Int               @default(0)
  streak            Int               @default(0)
  longestStreak     Int               @default(0)
  lastActiveAt      DateTime          @default(now())
  totalCharacters   Int               @default(0)
  lifetimeWpm       Float             @default(0)
  lifetimeAccuracy  Float             @default(0)
  practiceHours     Float             @default(0)
  typingDna         String?           @db.Text
  lastActivity      String?           @db.Text
  academyProgress   String?           @db.Text
  failedLoginAttempts Int             @default(0)
  lockoutUntil        DateTime?
  arenaPoints         Int               @default(100)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  sessions          TypingSession[]
  achievements      UserAchievement[]
  challenges        UserChallengeProgress[]
  mistakes          MistakeSummary[]
  recoveryHistory   RecoveryHistory[]
  arenaMatchesCreated ArenaMatch[]    @relation("MatchCreator")
  arenaParticipations ArenaParticipant[]
  arenaLedgerEntries  ArenaPointLedger[]
}

model TypingSession {
  id                 String         @id @default(uuid())
  userId             String
  user               User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode               String         // "English", "Python", "JavaScript", "Java", "SQL"
  difficulty         Int            // Smart Difficulty Level (1 to 5)
  wpm                Float
  rawWpm             Float
  accuracy           Float
  consistency        Float
  focusScore         Float
  duration           Float          // in seconds
  backspaceCount     Int
  correctionCount    Int
  predictionAccuracy Float?
  createdAt          DateTime       @default(now())

  keystrokes         KeystrokeLog[]

  @@index([userId])
}

model KeystrokeLog {
  id            String        @id @default(uuid())
  sessionId     String
  session       TypingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expectedKey   String
  actualKey     String
  reactionTime  Int           // in milliseconds
  holdTime      Int           // in milliseconds
  pauseDuration Int           // in milliseconds
  wordIndex     Int
  previousKey   String?
  nextKey       String?
  isMistake     Boolean
  timestamp     DateTime      @default(now())

  @@index([sessionId])
}

model MistakeSummary {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expectedKey String
  pressedKey  String
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@unique([userId, expectedKey, pressedKey])
}

model Achievement {
  id          String            @id @default(uuid())
  code        String            @unique // e.g. "STREAK_7", "WPM_80", "CHARS_10000"
  name        String
  description String
  icon        String
  category    String
  xpReward    Int
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(uuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  unlockedAt    DateTime    @default(now())

  @@unique([userId, achievementId])
}

model Challenge {
  id           String                  @id @default(uuid())
  type         String                  // "DAILY", "WEEKLY"
  title        String
  description  String
  criteriaType String                  // "WPM", "ACCURACY", "CHARS", "SESSIONS"
  targetValue  Float
  xpReward     Int
  expiresAt    DateTime
  createdAt    DateTime                @default(now())
  userProgress UserChallengeProgress[]
}

model UserChallengeProgress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  currentValue Float     @default(0)
  isCompleted Boolean   @default(false)
  updatedAt   DateTime  @updatedAt

  @@unique([userId, challengeId])
}

model RecoveryHistory {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mostMistypedKey   String
  confusionKey      String?
  accuracyLoss      Float
  predictedWpmGain  Float
  recoveryScore     Float    @default(0)
  createdAt         DateTime @default(now())

  @@index([userId])
}

model Feedback {
  id           String   @id @default(uuid())
  name         String
  email        String?
  device       String
  rating       Int
  whatWorked   String   @db.Text
  whatConfused String   @db.Text
  bugFound     String   @db.Text
  suggestion   String   @db.Text
  createdAt    DateTime @default(now())
}

model ArenaMatch {
  id                 String             @id @default(uuid())
  matchCode          String             @unique
  creatorId          String
  creator            User               @relation("MatchCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  status             String             @default("WAITING") // WAITING | READY | COUNTDOWN | ACTIVE | FINISHED | CANCELLED | EXPIRED
  passageId          String
  passageText        String             @db.Text
  passageTitle       String
  passageWordCount   Int
  stakeAmount        Int                @default(0)
  isRanked           Boolean            @default(false)
  maxDuration        Int                @default(120)
  countdownSeconds   Int                @default(5)
  winnerId           String?
  isTie              Boolean            @default(false)
  settlementStatus   String             @default("PENDING") // PENDING | SETTLED | REFUNDED
  cancellationReason String?
  idempotencyKey     String?            @unique
  createdAt          DateTime           @default(now())
  joinedAt           DateTime?
  startedAt          DateTime?
  finishedAt         DateTime?
  expiresAt          DateTime?

  participants       ArenaParticipant[]
  ledgerEntries      ArenaPointLedger[]

  @@index([status])
  @@index([creatorId])
  @@index([matchCode])
  @@index([createdAt])
}

model ArenaParticipant {
  id               String       @id @default(uuid())
  matchId          String
  match            ArenaMatch   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  seat             Int          // 1 (creator) or 2 (challenger)
  isReady          Boolean      @default(false)
  isConnected      Boolean      @default(true)
  lastPingAt       DateTime     @default(now())
  progressPercent  Float        @default(0)
  charsTyped       Int          @default(0)
  wpm              Float        @default(0)
  accuracy         Float        @default(0)
  completedAt      DateTime?
  completionTimeMs Int?
  outcome          String?      // WIN | LOSS | TIE | ABANDONED | CANCELLED
  stakeLocked      Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([matchId, userId])
  @@unique([matchId, seat])
  @@index([userId])
}

model ArenaPointLedger {
  id             String      @id @default(uuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  matchId        String?
  match          ArenaMatch? @relation(fields: [matchId], references: [id], onDelete: SetNull)
  amount         Int         // Signed integer change: -50 for lock, +100 for win
  type           String      // WELCOME_GRANT | STAKE_LOCK | MATCH_WIN | MATCH_REFUND | ADMIN_ADJUSTMENT
  idempotencyKey String      @unique
  balanceAfter   Int
  metadata       String?     @db.Text
  createdAt      DateTime    @default(now())

  @@index([userId])
  @@index([matchId])
  @@index([createdAt])
}

