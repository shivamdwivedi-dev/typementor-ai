# ===========================================
# TypeMentor Frontend Production Environment Template
# ===========================================

# Production Backend API Root URL (No trailing slash)
# Leave empty in local development to utilize Vite dev server proxy
VITE_API_URL="https://typementor-backend1.onrender.com"

# Google OAuth Client Token (Must match backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID="your_google_oauth_client_id.apps.googleusercontent.com"

# Guest mode practice storage toggle ('true' | 'false')
VITE_ENABLE_GUEST_MODE=true

# Telemetry and Analytics (Optional — leave empty to disable)
VITE_GA_MEASUREMENT_ID=""
VITE_CLARITY_PROJECT_ID=""
VITE_SENTRY_DSN=""
